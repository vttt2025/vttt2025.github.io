#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/deploy-preview-dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"

cp -- *.html *.css .nojekyll CNAME robots.txt sitemap.xml "$build_dir/"
for script in *.js; do
  [[ "$script" == "firebase-config.js" ]] || cp -- "$script" "$build_dir/"
done
cp -R -- assets data login signup "$build_dir/"

[[ -f "$build_dir/index.html" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}

figma make deploy-preview --build-dir "$build_dir"
